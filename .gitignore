# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Environment & secrets
.env
.venv/
venv/
env/

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Forecast restart folder (all raw files, restart CSVs, and restart logs)
forecasts_restart_datasets/*
!forecasts_restart_datasets/.gitkeep

# Raw, archived, and log files (keep folder structure via .gitkeep)
raw_datasets/*
!raw_datasets/.gitkeep

archived_dataset/*
!archived_dataset/.gitkeep

archived_viz_dataset/*
!archived_viz_dataset/.gitkeep

logs/*
!logs/.gitkeep
